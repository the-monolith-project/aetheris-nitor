---
import Layout from '../layouts/Layout.astro';
import Icono from '../components/Icono.astro';

const SALIDAS = [
  {
    href: '/',
    etiqueta: 'Inicio',
    descripcion: 'Portada del sistema con resumen de vigilancia y accesos rápidos.',
    icono: 'home',
  },
  {
    href: '/alertas',
    etiqueta: 'Alertas de campo',
    descripcion: 'Avisos epidemiológicos emitidos y canal de consulta sin conexión.',
    icono: 'bell',
  },
  {
    href: '/analisis',
    etiqueta: 'Análisis por departamento',
    descripcion: 'Herramientas descriptivas de dengue y enfermedad respiratoria.',
    icono: 'chart-bar',
  },
  {
    href: '/biblioteca',
    etiqueta: 'Biblioteca del sistema',
    descripcion: 'Documentación técnica, notas metodológicas y deslindes éticos.',
    icono: 'book',
  },
];
---

<Layout title="EPI-Aetheris — Página no encontrada" noindex={true}>
  <main
    id="contenido-principal"
    class="mx-auto max-w-3xl px-4 py-16 sm:px-8 sm:py-24"
  >
    <div class="card-elevated rounded-2xl border border-border bg-surface p-6 sm:p-10">
      <header class="border-b border-border pb-6">
        <p class="font-mono text-xs font-semibold uppercase tracking-wider text-accent">
          Error 404
        </p>
        <h1
          class="mt-2 font-display text-2xl font-semibold tracking-tight text-ink sm:text-3xl"
        >
          Esta página no existe
        </h1>
        <p class="mt-3 font-sans text-sm leading-relaxed text-ink-muted">
          La dirección solicitada no coincide con ninguna ruta activa en el sitio,
          o fue movida durante una actualización de la plataforma.
        </p>
      </header>

      <section class="mt-8">
        <h2 class="font-sans text-xs font-semibold uppercase tracking-wider text-ink-muted">
          Rutas principales disponibles
        </h2>
        <div class="mt-4 grid grid-cols-1 gap-3 sm:grid-cols-2">
          {
            SALIDAS.map((salida) => (
              <a
                href={salida.href}
                class="group flex flex-col justify-between rounded-xl border border-border bg-surface-raised p-4 transition-all hover:border-accent hover:bg-surface"
              >
                <div>
                  <div class="flex items-center gap-2 font-sans text-sm font-semibold text-ink group-hover:text-accent">
                    <Icono nombre={salida.icono} class="h-4 w-4 shrink-0 text-accent" />
                    <span>{salida.etiqueta}</span>
                  </div>
                  <p class="mt-1.5 font-sans text-xs leading-relaxed text-ink-muted">
                    {salida.descripcion}
                  </p>
                </div>
                <span class="mt-3 inline-flex items-center gap-1 font-sans text-xs font-medium text-accent">
                  Ir a {salida.etiqueta} &rarr;
                </span>
              </a>
            ))
          }
        </div>
      </section>
    </div>
  </main>
</Layout>
