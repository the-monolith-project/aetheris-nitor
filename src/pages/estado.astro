---
import Layout from '../layouts/Layout.astro';
import Icono from '../components/Icono.astro';

const apiBase = import.meta.env.PUBLIC_API_URL ?? 'http://localhost:8000';
---

<Layout
  title="EPI-Aetheris — Estado del servicio"
  descripcion="Monitorización en tiempo real del estado de la API y disponibilidad de la plataforma EPI-Aetheris."
>
  <main
    id="contenido-principal"
    class="mx-auto max-w-3xl px-4 py-8 sm:px-8 sm:py-10 lg:px-12"
  >
    <header class="mb-8">
      <p class="font-mono text-xs font-semibold uppercase tracking-wider text-accent">
        Disponibilidad de la plataforma
      </p>
      <h1
        class="mt-1 font-display text-2xl font-semibold tracking-tight text-ink sm:text-[1.75rem]"
      >
        Estado del servicio
      </h1>
      <p class="mt-3 font-sans text-sm leading-relaxed text-ink-muted">
        Comprobación directa de la conectividad de los componentes de EPI-Aetheris.
        El portal web se aloja en una CDN estática independiente y permanece disponible aun si el backend de cómputo se encuentra temporalmente inactivo.
      </p>
    </header>

    <div class="space-y-4">
      <!-- Componente 1: Frontend Web -->
      <div class="card-elevated flex items-center justify-between rounded-2xl border border-border bg-surface p-5">
        <div class="flex items-center gap-3.5">
          <span class="flex h-3 w-3 relative">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
            <span class="relative inline-flex rounded-full h-3 w-3 bg-emerald-500"></span>
          </span>
          <div>
            <h2 class="font-sans text-sm font-semibold text-ink">
              Frontend web y documentación (CDN)
            </h2>
            <p class="font-sans text-xs text-ink-muted">
              Páginas estáticas distribuidas globalmente mediante Render Static Site.
            </p>
          </div>
        </div>
        <span class="rounded-full bg-emerald-500/10 px-3 py-1 font-mono text-xs font-medium text-emerald-600 dark:text-emerald-400">
          Operativo
        </span>
      </div>

      <!-- Componente 2: Backend API -->
      <div class="card-elevated rounded-2xl border border-border bg-surface p-5">
        <div class="flex items-center justify-between">
          <div class="flex items-center gap-3.5">
            <span id="api-dot" class="flex h-3 w-3 rounded-full bg-amber-400"></span>
            <div>
              <h2 class="font-sans text-sm font-semibold text-ink">
                API pública de cómputo y datos
              </h2>
              <p class="font-sans text-xs text-ink-muted">
                Servicio FastAPI en Oregon (<code class="font-mono text-[11px]">{apiBase}</code>).
              </p>
            </div>
          </div>
          <div id="api-badge">
            <span class="rounded-full bg-amber-500/10 px-3 py-1 font-mono text-xs font-medium text-amber-600 dark:text-amber-400">
              Consultando…
            </span>
          </div>
        </div>

        <div id="api-contenedor-estado" class="mt-4 border-t border-border pt-3" role="status">
          <p class="font-sans text-xs text-ink-muted">
            Verificando respuesta del endpoint de salud (<code class="font-mono">/health</code>)...
          </p>
        </div>
      </div>
    </div>

    <!-- Explicación de arquitectura y arranque en frío -->
    <section class="mt-10 rounded-2xl border border-border bg-surface-raised p-6">
      <h2 class="font-sans text-xs font-semibold uppercase tracking-wider text-ink">
        Nota técnica sobre tiempos de respuesta
      </h2>
      <p class="mt-2 font-sans text-xs leading-relaxed text-ink-muted">
        El backend opera en el nivel Starter de Render. Tras periodos prolongados de inactividad,
        el proceso puede requerir entre 30 y 50 segundos para completar un arranque en frío (spin-up).
        Si la API reporta lentitud inicial o reintento, una vez despierto el contenedor las peticiones
        subsiguientes se responden en milisegundos.
      </p>
      <div class="mt-4 flex items-center gap-2">
        <a
          href={`${apiBase}/docs`}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 font-sans text-xs font-medium text-accent hover:underline"
        >
          <Icono nombre="api" class="h-3.5 w-3.5" />
          <span>Ver documentación interactiva de la API (/docs)</span>
        </a>
      </div>
    </section>
  </main>
</Layout>

<script is:inline define:vars={{ apiBase }}>
  const dot = document.getElementById('api-dot');
  const badge = document.getElementById('api-badge');
  const contenedor = document.getElementById('api-contenedor-estado');

  async function verificarSalud() {
    if (!contenedor || !badge || !dot) return;

    // Advertencia de configuración en build
    const urlEsLocalhost = apiBase.includes('localhost') || apiBase.includes('127.0.0.1');
    const origenEsRemoto = window.location.hostname !== 'localhost' && window.location.hostname !== '127.0.0.1';

    if (urlEsLocalhost && origenEsRemoto) {
      dot.className = 'flex h-3 w-3 rounded-full bg-amber-400';
      badge.innerHTML = '<span class="rounded-full bg-amber-500/10 px-3 py-1 font-mono text-xs font-medium text-amber-600">Configuración</span>';
      contenedor.innerHTML = '<p class="font-sans text-xs leading-relaxed text-ink-muted">Este despliegue fue compilado apuntando a <code>localhost</code> en vez de la URL pública de la API en Render. Esto es una discrepancia de configuración en build-time, no una caída del servicio.</p>';
      return;
    }

    dot.className = 'flex h-3 w-3 rounded-full bg-amber-400 animate-pulse';
    badge.innerHTML = '<span class="rounded-full bg-amber-500/10 px-3 py-1 font-mono text-xs font-medium text-amber-600">Comprobando…</span>';
    contenedor.innerHTML = '<p class="font-sans text-xs text-ink-muted">Enviando petición de diagnóstico a <code>/health</code>…</p>';

    const inicio = performance.now();
    try {
      const res = await fetch(`${apiBase}/health`, {
        method: 'GET',
        headers: { Accept: 'application/json' },
      });
      const latencia = Math.round(performance.now() - inicio);

      if (res.ok) {
        dot.className = 'flex h-3 w-3 rounded-full bg-emerald-500';
        badge.innerHTML = '<span class="rounded-full bg-emerald-500/10 px-3 py-1 font-mono text-xs font-medium text-emerald-600 dark:text-emerald-400">Disponible</span>';
        contenedor.innerHTML = `<p class="font-sans text-xs text-ink-muted">La API respondió correctamente con código <code>${res.status}</code> en <strong>${latencia} ms</strong>.</p>`;
      } else {
        dot.className = 'flex h-3 w-3 rounded-full bg-rose-500';
        badge.innerHTML = `<span class="rounded-full bg-rose-500/10 px-3 py-1 font-mono text-xs font-medium text-rose-600">Error ${res.status}</span>`;
        mostrarReintento(`El servidor respondió con código de error HTTP ${res.status}.`);
      }
    } catch (err) {
      dot.className = 'flex h-3 w-3 rounded-full bg-rose-500';
      badge.innerHTML = '<span class="rounded-full bg-rose-500/10 px-3 py-1 font-mono text-xs font-medium text-rose-600">Sin conexión</span>';
      mostrarReintento(`No se pudo establecer conexión con la API (${String(err)}). Podría estar arrancando en frío.`);
    }
  }

  function mostrarReintento(mensaje) {
    if (!contenedor) return;
    contenedor.innerHTML = '';
    const caja = document.createElement('div');
    caja.className = 'rounded-lg border border-secondary bg-secondary/25 p-3';

    const p = document.createElement('p');
    p.className = 'font-sans text-xs leading-relaxed text-ink';
    p.textContent = mensaje;

    const btn = document.createElement('button');
    btn.type = 'button';
    btn.className = 'mt-2 rounded-lg border border-border bg-surface px-3 py-1.5 font-sans text-xs font-semibold text-ink transition-colors hover:border-accent/50 hover:text-accent';
    btn.textContent = 'Reintentar verificación';
    btn.addEventListener('click', () => verificarSalud());

    caja.appendChild(p);
    caja.appendChild(btn);
    contenedor.appendChild(caja);
  }

  verificarSalud();
</script>
