---
import Layout from '../../layouts/Layout.astro';
import Icono from '../../components/Icono.astro';

const SECCIONES = [
  {
    href: '/legal/privacidad',
    titulo: 'Política de Privacidad y Protección de Datos',
    descripcion:
      'Régimen de tratamiento de metadatos de red, ausencia de cookies, estipulaciones sobre almacenamiento local, salvaguardas y cesión técnica a proveedores como OpenStreetMap.',
    icono: 'shield-check',
  },
  {
    href: '/legal/terminos',
    titulo: 'Términos y Condiciones Generales de Uso',
    descripcion:
      'Contrato vinculante de navegación, deslinde médico pericial, condiciones de explotación de la API pública, conductas prohibidas, licencias y exoneración de responsabilidad.',
    icono: 'file-text',
  },
  {
    href: '/legal/aviso-legal',
    titulo: 'Aviso Legal e Información General',
    descripcion:
      'Identificación del titular del dominio, domicilio postal, naturaleza no lucrativa de la actividad, proveedor de alojamiento telemático y régimen de jurisdicción aplicable.',
    icono: 'building',
  },
];
---

<Layout
  title="EPI-Aetheris — Marco jurídico e institucional"
  descripcion="Índice formal de instrumentos jurídicos, régimen de privacidad y condiciones de uso de EPI-Aetheris."
>
  <main
    id="contenido-principal"
    class="mx-auto max-w-4xl px-4 py-8 sm:px-8 sm:py-10 lg:px-12"
  >
    <header class="mb-8">
      <p
        class="font-mono text-xs font-semibold uppercase tracking-wider text-accent"
      >
        Gobernanza y Transparencia
      </p>
      <h1
        class="mt-2 font-display text-2xl font-semibold tracking-tight text-ink sm:text-3xl"
      >
        Marco jurídico e institucional
      </h1>
      <p
        class="mt-3 max-w-2xl font-sans text-sm leading-relaxed text-ink-muted"
      >
        Instrumentos normativos que regulan las condiciones de acceso,
        navegación telemática, garantías de protección de datos personales y los
        límites perentorios de responsabilidad jurídica de la plataforma.
      </p>
    </header>

    <div class="grid grid-cols-1 gap-4 sm:grid-cols-3">
      {
        SECCIONES.map((sec) => (
          <a
            href={sec.href}
            class="card-elevated group flex flex-col justify-between rounded-2xl border border-border bg-surface p-5 transition-all hover:border-accent"
          >
            <div>
              <div class="flex items-center gap-2 font-sans text-base font-semibold text-ink group-hover:text-accent">
                <Icono
                  nombre={sec.icono}
                  class="h-5 w-5 text-accent shrink-0"
                />
                <span>{sec.titulo}</span>
              </div>
              <p class="mt-2 font-sans text-xs leading-relaxed text-ink-muted">
                {sec.descripcion}
              </p>
            </div>
            <span class="mt-4 inline-flex items-center gap-1 font-sans text-xs font-medium text-accent">
              Consultar instrumento &rarr;
            </span>
          </a>
        ))
      }
    </div>
  </main>
</Layout>
