---
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import DocumentoTexto from '../../components/DocumentoTexto.astro';

export async function getStaticPaths() {
  const entradas = await getCollection('biblioteca');
  return entradas.map((entrada: CollectionEntry<'biblioteca'>) => ({
    params: { slug: entrada.id },
    props: { entrada },
  }));
}

interface Props {
  entrada: CollectionEntry<'biblioteca'>;
}

const { entrada } = Astro.props;
const { Content } = await render(entrada);
const { titulo, descripcion } = entrada.data;
---

<DocumentoTexto
  titulo={titulo}
  descripcion={descripcion}
  volver={{ href: '/biblioteca', etiqueta: 'Volver a la biblioteca' }}
>
  <Content />
</DocumentoTexto>
