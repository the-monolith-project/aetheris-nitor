---
interface Enlace {
  href: string;
  etiqueta: string;
}

interface Props {
  etiqueta: string;
  enlaces: Enlace[];
  class?: string;
}

const { etiqueta, enlaces, class: clasePersonalizada = 'mb-6' } = Astro.props;
const rutaActual = Astro.url.pathname.replace(/\/+$/, '') || '/';
---

<nav
  class:list={['flex flex-wrap gap-2 font-sans text-sm', clasePersonalizada]}
  aria-label={etiqueta}
  data-nav-secciones
>
  {
    enlaces.map((enlace) => {
      const hrefLimpio = enlace.href.replace(/\/+$/, '') || '/';
      const esActivo =
        !enlace.href.startsWith('#') &&
        (hrefLimpio === rutaActual ||
          (hrefLimpio !== '/' && rutaActual.startsWith(hrefLimpio)));
      return (
        <a
          href={enlace.href}
          aria-current={esActivo ? 'page' : undefined}
          class:list={[
            'inline-flex min-h-[44px] items-center rounded-full border px-3 py-1.5 transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent',
            esActivo
              ? 'border-accent bg-accent/10 font-semibold text-accent'
              : 'border-border bg-surface hover:border-accent/50 hover:text-accent',
          ]}
        >
          {enlace.etiqueta}
        </a>
      );
    })
  }
</nav>
