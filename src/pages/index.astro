---
import { readFileSync } from 'node:fs';
import { join } from 'node:path';
import Layout from '../layouts/Layout.astro';

// Landing de presentación (antes de entrar a la vista dengue en /dengue). No
// repite el dashboard: explica qué es el proyecto, qué pregunta responde y
// qué explícitamente NO hace, antes de que alguien vea un mapa sin contexto.
// Mismo lenguaje de estatuto que el resto del sitio: descriptivo, no
// predictivo, ayuda de priorización — nunca diagnóstico ni pronóstico.
//
// Contenedor a max-w-[1600px] (mismo ancho que el header/footer del Layout):
// en pantallas anchas una versión angosta dejaba la mitad de la pantalla en
// blanco.
//
// Firma visual (revisión de diseño 2026-08-22): el hero ya NO usa el patrón
// genérico "número grande + etiqueta + stats" — ese patrón describía el
// proyecto desde afuera. En su lugar, la mitad derecha es el propio mapa
// departamental (14 siluetas reales, del mismo geojson que consume
// MapaDepartamentos.astro en /dengue), proyectado a SVG en build time. Es el
// objeto central del proyecto mostrándose a sí mismo, no una cifra sobre él.
// Las 4 cifras que antes eran una grilla de tarjetas ahora son una sola
// línea de texto (ver <CIFRAS>) — información de pie, no la pieza visual.

interface DepartamentoGeo {
  codigo: string;
  nombre: string;
  d: string;
  cx: number;
  cy: number;
}

function construirSiluetaDepartamentos(): {
  paths: DepartamentoGeo[];
  viewBox: string;
} {
  // No usar new URL('../../public/...', import.meta.url): en dev resuelve
  // contra la ruta fuente real, pero astro build empaqueta este codigo en
  // dist/.prerender/chunks/, asi que la misma ruta relativa termina
  // apuntando a dist/public/geo/... — ese directorio no existe, Astro copia
  // public/ a la raiz de dist/ (dist/geo/...). process.cwd() es estable en
  // ambos casos: astro build y astro dev corren con cwd en la raiz de web/.
  const ruta = join(process.cwd(), 'public/geo/slv-adm1.geojson');
  const geojson = JSON.parse(readFileSync(ruta, 'utf-8'));

  const ANCHO = 480;
  const ALTO = 340;
  const MARGEN = 10;

  let minLon = Infinity;
  let minLat = Infinity;
  let maxLon = -Infinity;
  let maxLat = -Infinity;
  for (const f of geojson.features) {
    const anillos =
      f.geometry.type === 'Polygon'
        ? [f.geometry.coordinates]
        : f.geometry.coordinates;
    for (const poligono of anillos) {
      for (const anillo of poligono) {
        for (const [lon, lat] of anillo) {
          if (lon < minLon) minLon = lon;
          if (lon > maxLon) maxLon = lon;
          if (lat < minLat) minLat = lat;
          if (lat > maxLat) maxLat = lat;
        }
      }
    }
  }

  // Corrección de aspecto: 1° de longitud cubre menos distancia real que 1°
  // de latitud a esta latitud (~14°N) — sin esto, El Salvador se ve
  // artificialmente ancho.
  const corrOAspecto = Math.cos(((minLat + maxLat) / 2) * (Math.PI / 180));
  const anchoGeo = (maxLon - minLon) * corrOAspecto;
  const altoGeo = maxLat - minLat;
  const escala = Math.min(
    (ANCHO - MARGEN * 2) / anchoGeo,
    (ALTO - MARGEN * 2) / altoGeo,
  );
  const offsetX = (ANCHO - anchoGeo * escala) / 2;
  const offsetY = (ALTO - altoGeo * escala) / 2;

  const proyectar = ([lon, lat]: [number, number]): [number, number] => {
    const x = (lon - minLon) * corrOAspecto * escala + offsetX;
    const y = ALTO - ((lat - minLat) * escala + offsetY);
    return [x, y];
  };

  const paths: DepartamentoGeo[] = geojson.features.map((f: any) => {
    const anillos =
      f.geometry.type === 'Polygon'
        ? [f.geometry.coordinates]
        : f.geometry.coordinates;
    let bxMin = Infinity;
    let bxMax = -Infinity;
    let byMin = Infinity;
    let byMax = -Infinity;
    const d = anillos
      .map((poligono: number[][][]) =>
        poligono
          .map((anillo: [number, number][]) => {
            const puntos = anillo.map(proyectar);
            for (const [x, y] of puntos) {
              if (x < bxMin) bxMin = x;
              if (x > bxMax) bxMax = x;
              if (y < byMin) byMin = y;
              if (y > byMax) byMax = y;
            }
            return `M${puntos.map(([x, y]) => `${x.toFixed(1)},${y.toFixed(1)}`).join('L')}Z`;
          })
          .join(' '),
      )
      .join(' ');
    return {
      codigo: f.properties.codigo,
      nombre: f.properties.shapeName.replace(/^Departamento de /, ''),
      d,
      cx: Number(((bxMin + bxMax) / 2).toFixed(1)),
      cy: Number(((byMin + byMax) / 2).toFixed(1)),
    };
  });

  return { paths, viewBox: `0 0 ${ANCHO} ${ALTO}` };
}

const { paths: DEPARTAMENTOS_SVG, viewBox: MAPA_VIEWBOX } =
  construirSiluetaDepartamentos();

// --- Contenido de la portada ----------------------------------------------
// Redaccion (rediseno 2026-09): afirmativa. Cada bloque dice lo que el
// sistema hace; no hay panel de "no hace esto". Los deslindes que si son
// vinculantes viven en el pie de pagina y, con su argumento completo, en
// RUTA_SENSIBILIDAD -- que es justamente para lo que existe ese export.

const CIFRAS = [
  { valor: '14', etiqueta: 'departamentos' },
  { valor: '3', etiqueta: 'fuentes publicas' },
  { valor: '2018–2024', etiqueta: 'serie historica' },
  { valor: '$0', etiqueta: 'costo de replicar' },
];

const MODULOS = [
  {
    id: 'M1',
    nombre: 'Idoneidad biofísica',
    texto:
      'Índice continuo de qué tan favorables son la temperatura, la precipitación y la humedad de cada departamento para el vector del dengue, semana a semana.',
  },
  {
    id: 'M2',
    nombre: 'Anomalía climática',
    texto:
      'Sitúa la idoneidad de esta semana dentro de la historia climática del propio departamento, con registros desde 2014.',
  },
  {
    id: 'M3',
    nombre: 'Presión epidemiológica relativa',
    texto:
      'Ubica los casos observados —probable y confirmado por separado— como percentil dentro de la serie histórica del departamento.',
  },
  {
    id: 'M4',
    nombre: 'Integridad de la vigilancia',
    texto:
      'Tres hechos verificables sobre la calidad del dato: completitud geográfica, cuadre del boletín y antigüedad de cada serie.',
  },
];

const APORTES = [
  {
    titulo: 'Levanta entero en un comando',
    texto:
      'Base de datos, API y sitio en tres contenedores, con los datos reales ya cargados. Código abierto bajo GPL-3.0.',
  },
  {
    titulo: 'Cada departamento, contra su propia historia',
    texto:
      'Catorce departamentos leídos contra sus propios años anteriores, que es donde se ven las diferencias regionales.',
  },
  {
    titulo: 'Validado contra los brotes reales',
    texto:
      'Cada capa se contrasta con los años de brote documentados del país antes de entrar al sistema.',
  },
];

const STACK = [
  {
    capa: 'Backend',
    tecnologia: 'Python · FastAPI',
    texto:
      'API REST sobre PostgreSQL directo, sin ORM. Todas las capas del mapa se calculan por petición.',
  },
  {
    capa: 'Base de datos',
    tecnologia: 'PostgreSQL 15',
    texto:
      'Esquema agnóstico a enfermedad y región: catálogos en vez de columnas fijas, así dengue e IRA comparten tabla de casos.',
  },
  {
    capa: 'Frontend',
    tecnologia: 'Astro · TypeScript · Leaflet',
    texto:
      'Sitio estático con mapa departamental interactivo, sobre la misma API pública que cualquiera puede llamar.',
  },
  {
    capa: 'Infraestructura',
    tecnologia: 'Docker Compose',
    texto:
      'Tres servicios orquestados juntos. Sin API de pago y sin suscripción obligatoria en ninguna capa.',
  },
];
---

<Layout title="EPI-Aetheris">
  <main id="contenido-principal">
    {
      /* ---------------------------------------------------------------
        Hero a sangre sobre --color-deep. El objeto del proyecto (los 14
        departamentos, proyectados en build desde el mismo geojson que usa
        MapaDepartamentos en /dengue) se presenta a si mismo y ademas es
        navegable: cada silueta es un enlace real a su ficha imprimible.
        --------------------------------------------------------------- */
    }
    <section class="bg-deep">
      <div
        class="mx-auto max-w-[1600px] px-4 pb-10 pt-12 sm:px-8 sm:pb-12 sm:pt-16 lg:px-12"
      >
        {
          /* El titular ocupa el ancho completo del contenedor en vez de media
            reja: es la pieza de diseno del hero, y a media reja "Catorce
            departamentos." se partia en dos lineas y perdia el ritmo de tres.
            Debajo, el texto de apoyo y el mapa reparten el ancho. */
        }
        <h1 class="titular-hero max-w-[20ch] text-secondary lg:max-w-none">
          Catorce departamentos.<br />
          Siete años de dengue.<br />
          Un comando.
        </h1>

        <div
          class="mt-10 grid grid-cols-1 items-start gap-10 lg:grid-cols-[1fr_0.8fr] lg:gap-16"
        >
          <div>
            <p
              class="max-w-xl font-sans text-base leading-relaxed text-deep-ink-muted sm:text-lg"
            >
              EPI-Aetheris cruza los casos que publica el MINSAL con el clima de
              Open-Meteo y describe, semana a semana, qué tan inusual es lo que
              ocurre en cada departamento frente a su propia historia.
            </p>

            <div class="mt-8 flex flex-wrap items-center gap-3">
              <a
                href="/dengue"
                class="inline-flex min-h-[44px] items-center rounded-full bg-secondary px-6 font-sans text-sm font-semibold text-secondary-ink transition-[transform,filter] duration-200 hover:-translate-y-0.5 hover:brightness-105 active:translate-y-0"
              >
                Ver dengue
              </a>
              <a
                href="https://github.com/the-monolith-project/EPI-Aetheris"
                class="inline-flex min-h-[44px] items-center rounded-full border border-white/25 px-6 font-sans text-sm font-medium text-deep-ink transition-colors duration-200 hover:border-white/60 hover:bg-white/5"
              >
                Ver el código
              </a>
            </div>
          </div>

          <div class="w-full lg:justify-self-end lg:max-w-[30rem]">
            <svg
              viewBox={MAPA_VIEWBOX}
              role="group"
              aria-label="Mapa de los 14 departamentos de El Salvador. Cada uno abre su ficha departamental."
              class="mapa-hero h-auto w-full"
            >
              {
                DEPARTAMENTOS_SVG.map((d, i) => (
                  <a
                    href={`/analisis/ficha/${d.codigo}`}
                    aria-label={`Ficha departamental de ${d.nombre}`}
                    class="depto"
                    style={`--retraso:${i * 40}ms`}
                  >
                    <title>{d.nombre}</title>
                    <path d={d.d} class="depto-forma" />
                    <text
                      x={d.cx}
                      y={d.cy}
                      text-anchor="middle"
                      dominant-baseline="middle"
                      font-size="11"
                      class="depto-nombre"
                    >
                      {d.nombre}
                    </text>
                  </a>
                ))
              }
            </svg>
            <p
              class="mt-2 text-right font-sans text-xs leading-snug text-deep-ink-muted"
            >
              Cada departamento abre su ficha imprimible.
            </p>
          </div>
        </div>

        {
          /* Cifras como pares valor/etiqueta con filete divisorio, no como una
            cadena unida por puntos medios: el numero es el dato y la etiqueta
            lo nombra. */
        }
        <dl
          class="mt-12 grid grid-cols-2 gap-x-6 gap-y-8 border-t border-white/12 pt-8 sm:grid-cols-4"
        >
          {
            CIFRAS.map((c) => (
              <div>
                <dt class="font-mono text-xl text-secondary sm:text-2xl">
                  {c.valor}
                </dt>
                <dd class="mt-1 font-sans text-xs leading-snug text-deep-ink-muted">
                  {c.etiqueta}
                </dd>
              </div>
            ))
          }
        </dl>
      </div>
    </section>

    <div class="mx-auto max-w-[1600px] px-4 py-14 sm:px-8 sm:py-16 lg:px-12">
      {
        /* Enfoque dual (ADR 0014). Dos puertas, no un modo con estado: son
          enlaces normales, asi que un enlace compartido funciona igual para
          cualquiera y no hay dos arquitecturas que mantener sincronizadas. */
      }
      <section aria-labelledby="puertas-titulo">
        <h2 id="puertas-titulo" class="sr-only">Por dónde entrar</h2>
        <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
          <a
            href="/alertas"
            data-puerta="consulta"
            class="superficie-pulsable group flex flex-col rounded-2xl border border-border bg-surface p-6 sm:p-8"
          >
            <h3 class="titular-seccion text-ink">Qué hay vigente</h3>
            <p class="mt-3 font-sans text-sm leading-relaxed text-ink-muted">
              Alertas de campo redactadas por el equipo de vigilancia, con las
              indicaciones para la unidad. Sirve en consulta, se imprime y queda
              disponible sin señal.
            </p>
            <span class="mt-6 font-sans text-sm font-semibold text-accent">
              <span class="enlace-filete">Ver alertas de campo</span>
            </span>
          </a>

          <a
            href="/analisis"
            data-puerta="analisis"
            class="superficie-pulsable group flex flex-col rounded-2xl border border-border bg-surface p-6 sm:p-8"
          >
            <h3 class="titular-seccion text-ink">Explorar las series</h3>
            <p class="mt-3 font-sans text-sm leading-relaxed text-ink-muted">
              Dengue, neumonías e IRA por departamento, cada uno contra su
              propia historia. Los mismos datos que expone la API pública.
            </p>
            <span class="mt-6 font-sans text-sm font-semibold text-accent">
              <span class="enlace-filete">Abrir herramientas de análisis</span>
            </span>
          </a>
        </div>
      </section>

      {
        /* Tira de alertas vigentes: el unico estado que cambia en la portada,
          y el unico lugar donde aparece el coral de la marca. Si el backend
          no responde, la seccion entera se queda oculta. */
      }
      <section data-tira-alertas hidden class="mt-4">
        <div class="rounded-2xl border border-live/30 bg-surface p-6 sm:p-8">
          <div class="flex flex-wrap items-center justify-between gap-3">
            <h2
              class="flex items-center gap-2.5 font-sans text-sm font-semibold text-ink"
            >
              <span class="punto-vigente" aria-hidden="true"></span>
              Alertas de campo vigentes
            </h2>
            <a
              href="/alertas"
              class="font-sans text-sm font-medium text-accent"
            >
              <span class="enlace-filete">Ver todas</span>
            </a>
          </div>
          <ul data-tira-alertas-lista class="mt-4 space-y-2.5"></ul>
        </div>
      </section>

      {
        /* Aportes: la afirmacion mas fuerte del proyecto, sobre el verde
          primario. Columnas con filete, sin tarjetas -- no son destinos. */
      }
      <section
        class="mt-14 rounded-2xl bg-accent p-8 sm:p-10 lg:p-12"
        aria-labelledby="aportes-titulo"
      >
        <h2 id="aportes-titulo" class="titular-seccion max-w-2xl text-white">
          Ingeniería reproducible sobre datos que ya son públicos
        </h2>
        <div class="mt-8 grid grid-cols-1 gap-8 sm:grid-cols-3 sm:gap-10">
          {
            APORTES.map((a, i) => (
              <div
                class:list={[
                  i > 0 && 'sm:border-l sm:border-white/15 sm:pl-10',
                ]}
              >
                <h3 class="font-sans text-sm font-semibold text-white">
                  {a.titulo}
                </h3>
                <p class="mt-2 font-sans text-sm leading-relaxed text-white/75">
                  {a.texto}
                </p>
              </div>
            ))
          }
        </div>
      </section>

      {
        /* Modulos: cuatro preguntas paralelas. Filetes verticales en vez de
          cuatro tarjetas identicas -- no son pulsables, asi que no llevan la
          superficie elevada. */
      }
      <section class="mt-16" aria-labelledby="modulos-titulo">
        <h2 id="modulos-titulo" class="titular-seccion text-ink">
          Cuatro preguntas, cuatro módulos
        </h2>
        <p
          class="mt-3 max-w-2xl font-sans text-base leading-relaxed text-ink-muted"
        >
          En vez de «¿va a haber un brote?», cada módulo responde una pregunta
          más chica y comprobable contra la propia historia del departamento.
        </p>
        <div
          class="mt-10 grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-4 lg:gap-10"
        >
          {
            MODULOS.map((m, i) => (
              <div
                class:list={[
                  'border-t-2 border-accent pt-4',
                  i > 0 &&
                    'lg:border-l lg:border-l-border lg:pl-10 lg:border-t-2',
                ]}
              >
                <p class="font-mono text-xs font-semibold text-accent">
                  {m.id}
                </p>
                <h3 class="mt-2 font-sans text-base font-semibold text-ink">
                  {m.nombre}
                </h3>
                <p class="mt-2 font-sans text-sm leading-relaxed text-ink-muted">
                  {m.texto}
                </p>
              </div>
            ))
          }
        </div>
      </section>

      {
        /* Stack: hoja de especificaciones, no tarjetas. El contenido es una
          tabla de capa/tecnologia/nota y se lee mejor como tal. */
      }
      <section class="mt-16" aria-labelledby="stack-titulo">
        <h2 id="stack-titulo" class="titular-seccion text-ink">
          Con qué está construido
        </h2>
        <p
          class="mt-3 max-w-2xl font-sans text-base leading-relaxed text-ink-muted"
        >
          El aporte del proyecto es de ingeniería de software, así que el stack
          importa tanto como los módulos.
        </p>
        <dl class="mt-8 border-t border-border">
          {
            STACK.map((s) => (
              <div class="grid grid-cols-1 gap-1 border-b border-border py-5 sm:grid-cols-[10rem_14rem_1fr] sm:items-baseline sm:gap-6">
                <dt class="font-sans text-sm font-semibold text-ink">
                  {s.capa}
                </dt>
                <dd class="font-mono text-sm text-accent">{s.tecnologia}</dd>
                <dd class="font-sans text-sm leading-relaxed text-ink-muted">
                  {s.texto}
                </dd>
              </div>
            ))
          }
        </dl>
      </section>

      <section
        class="mt-16 flex flex-col items-start gap-6 rounded-2xl bg-deep p-8 sm:flex-row sm:items-center sm:justify-between lg:p-12"
        aria-labelledby="replicar-titulo"
      >
        <div class="max-w-2xl">
          <h2 id="replicar-titulo" class="titular-seccion text-secondary">
            Levantalo vos mismo
          </h2>
          <p class="mt-3 font-sans text-sm leading-relaxed text-deep-ink-muted">
            <code
              class="rounded bg-white/10 px-1.5 py-0.5 font-mono text-deep-ink"
              >docker compose up</code
            > deja el sistema completo corriendo con datos reales. El porqué de cada
            decisión está en la <a
              href="/biblioteca"
              class="font-semibold text-deep-ink"
              ><span class="enlace-filete">Biblioteca</span></a
            >.
          </p>
        </div>
        <a
          href="/dengue"
          class="inline-flex min-h-[44px] shrink-0 items-center rounded-full bg-secondary px-6 font-sans text-sm font-semibold text-secondary-ink transition-[transform,filter] duration-200 hover:-translate-y-0.5 hover:brightness-105 active:translate-y-0"
        >
          Entrar a dengue
        </a>
      </section>
    </div>
  </main>
</Layout>

<script>
  import {
    ETIQUETAS_NIVEL,
    ETIQUETAS_TIPO,
    type PayloadAlertas,
  } from '../lib/vista-alertas';

  const API_BASE = import.meta.env.PUBLIC_API_URL ?? 'http://localhost:8000';
  const seccion = document.querySelector<HTMLElement>('[data-tira-alertas]');
  const lista = document.querySelector<HTMLElement>(
    '[data-tira-alertas-lista]',
  );

  if (seccion && lista) {
    fetch(`${API_BASE}/api/alertas`)
      .then(async (respuesta) => {
        if (!respuesta.ok) throw new Error(String(respuesta.status));
        const datos = (await respuesta.json()) as PayloadAlertas;
        if (!Array.isArray(datos.alertas) || datos.alertas.length === 0) return;

        for (const alerta of datos.alertas.slice(0, 3)) {
          const item = document.createElement('li');
          item.className =
            'flex flex-wrap items-baseline gap-x-2.5 font-sans text-sm leading-relaxed';
          const etiqueta = document.createElement('span');
          etiqueta.className =
            'font-mono text-xs font-semibold uppercase tracking-wide text-accent';
          const etiquetaNivel =
            alerta.nivel in ETIQUETAS_NIVEL
              ? ETIQUETAS_NIVEL[alerta.nivel as keyof typeof ETIQUETAS_NIVEL]
              : alerta.nivel;
          etiqueta.textContent = `${ETIQUETAS_TIPO[alerta.tipo] ?? alerta.tipo} · ${etiquetaNivel}`;
          const enlace = document.createElement('a');
          enlace.href = `/alertas?tipo=${encodeURIComponent(alerta.tipo)}#alerta-${alerta.id}`;
          enlace.className = 'enlace-filete text-ink';
          // textContent, no innerHTML: el titulo lo redacta una persona y
          // llega como texto plano desde la API.
          enlace.textContent = alerta.titulo;
          item.append(etiqueta, enlace);
          lista.appendChild(item);
        }
        seccion.hidden = false;
      })
      .catch(() => {
        // Backend caido o dormido: la portada se queda sin la tira y ya.
      });
  }
</script>

<style>
  /* Entrada del mapa: los 14 departamentos se dibujan una sola vez al cargar,
     escalonados por --retraso. Es el unico movimiento no disparado por la
     persona en todo el sitio. El piso global de prefers-reduced-motion
     (global.css) lo acorta a ~0ms, asi que el mapa aparece ya dibujado. */
  .depto-forma {
    fill: color-mix(in srgb, var(--color-secondary) 90%, transparent);
    stroke: var(--color-deep);
    stroke-width: 1.5;
    transition:
      fill 180ms ease,
      stroke 180ms ease;
    animation: depto-entra 420ms cubic-bezier(0.16, 1, 0.3, 1) both;
    animation-delay: var(--retraso, 0ms);
  }

  /* El nombre solo aparece cuando la persona apunta o enfoca ese
     departamento: el mapa se mantiene limpio y el rotulo es la respuesta al
     gesto, no un adorno permanente. */
  .depto-nombre {
    fill: var(--color-deep);
    font-family: var(--font-sans);
