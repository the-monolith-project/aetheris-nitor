---
/**
 * Envoltorio de las páginas de texto largo: las tres legales, acerca de y los
 * documentos de la Biblioteca (markdown compartido con el monorepo). Da el
 * mismo bloque de lectura a todas: tarjeta elevada y centrada, titular en
 * Fraunces y la prosa de `.doc-texto`.
 *
 * Cada `<h2>` del contenido se convierte en un acordeón nativo (`<details>`),
 * de modo que un documento largo se lee por secciones en lugar de como un
 * muro de texto. Solo la primera sección arranca abierta. El `<code>` en
 * línea se sustituye por texto normal (ver `src/lib/acordeones.ts`).
 */
import Layout from '../layouts/Layout.astro';
import { agruparEnAcordeones, sinCodigoEnLinea } from '../lib/acordeones';

interface Props {
  titulo: string;
  descripcion: string;
  /** Fecha visible de última revisión. Obligatoria en las legales: sin ella
   *  el lector no sabe qué versión está aceptando. */
  actualizado?: string;
  /** Rótulo pequeño sobre el titular (p. ej. "Documento legal"). */
  seccion?: string;
  /** Enlace de regreso sobre la tarjeta (p. ej. a la Biblioteca). */
  volver?: { href: string; etiqueta: string };
  /** Cuántas secciones arrancan desplegadas, desde la primera. */
  abiertos?: number;
}

const { titulo, descripcion, actualizado, seccion, volver, abiertos } =
  Astro.props;

const crudo = sinCodigoEnLinea(await Astro.slots.render('default'));
const { html: contenido, total: secciones } = agruparEnAcordeones(
  crudo,
  abiertos ?? 1,
);
const controles =
  secciones > 1
    ? '<p class="acordeones-controles"><button type="button" data-acordeones-alternar>Expandir todo</button></p>'
    : '';
const cuerpo = contenido.replace(
  '<div class="acordeones">',
  `${controles}<div class="acordeones">`,
);
---

<Layout title={`EPI-Aetheris — ${titulo}`} descripcion={descripcion}>
  <main
    id="contenido-principal"
    class="mx-auto max-w-[1600px] px-4 py-8 sm:px-8 sm:py-10 lg:px-12"
  >
    {
      volver && (
        <a
          href={volver.href}
          class="mx-auto mb-4 flex max-w-[52rem] items-center gap-1.5 font-sans text-sm font-medium text-accent hover:underline"
        >
          &larr; {volver.etiqueta}
        </a>
      )
    }
    <article
      class="card-elevated mx-auto max-w-[52rem] rounded-2xl border border-border bg-surface p-6 sm:p-8"
    >
      <header class="border-b border-border pb-5">
        {
          seccion && (
            <p class="font-sans text-xs font-semibold uppercase tracking-wider text-accent">
              {seccion}
            </p>
          )
        }
        <h1
          class="mt-1 font-display text-2xl font-semibold leading-tight tracking-tight text-ink sm:text-[2rem]"
        >
          {titulo}
        </h1>
        <p class="mt-3 font-sans text-sm leading-relaxed text-ink-muted">
          {descripcion}
        </p>
        {
          actualizado && (
            <p class="mt-4 font-mono text-[11px] text-ink-muted">
              Última actualización: {actualizado}
            </p>
          )
        }
      </header>
      <div class="doc-texto mt-2 font-sans text-ink" set:html={cuerpo} />
    </article>
  </main>
</Layout>

<style is:global>
  /* Prosa de las páginas de texto largo. Es la única hoja de lectura: la
     Biblioteca usa este mismo bloque, así que no hay una copia para markdown. */
  .doc-texto {
    font-size: 1.0625rem;
    line-height: 1.7;
  }
  .doc-texto h2 {
    font-family: var(--font-display);
    font-size: 1.4rem;
    font-weight: 600;
    line-height: 1.25;
    color: var(--color-ink);
    margin-top: 2.75rem;
    margin-bottom: 0.6rem;
  }
  .doc-texto h3 {
    font-size: 1.05rem;
    font-weight: 600;
    letter-spacing: 0.01em;
    color: var(--color-ink);
    margin-top: 1.75rem;
    margin-bottom: 0.4rem;
  }
  .doc-texto p {
    margin-top: 0.9rem;
    margin-bottom: 0.9rem;
  }
  .doc-texto ul,
  .doc-texto ol {
    margin-top: 0.5rem;
    margin-bottom: 0.75rem;
    padding-left: 1.25rem;
  }
  .doc-texto ul {
    list-style: disc;
  }
  .doc-texto ol {
    list-style: decimal;
  }
  .doc-texto li {
    margin-top: 0.35rem;
  }
  .doc-texto li > ul,
  .doc-texto li > ol {
    margin-top: 0.35rem;
    margin-bottom: 0;
  }
  .doc-texto a {
    color: var(--color-accent);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .doc-texto strong {
    font-weight: 600;
    color: var(--color-ink);
  }
  /* Nombres de campo, tablas y funciones citados en el texto: se distinguen
     por el peso, sin recuadro ni tipografía monoespaciada. */
  .doc-texto .termino {
    font-weight: 600;
    color: var(--color-ink);
    overflow-wrap: anywhere;
  }
  .doc-texto pre {
    background: var(--color-deep);
    color: var(--color-deep-ink);
    border-radius: 12px;
    padding: 1rem;
    overflow-x: auto;
    margin: 1rem 0;
    font-family: var(--font-mono);
    font-size: 0.85em;
  }
  .doc-texto table {
    width: 100%;
    border-collapse: collapse;
    margin: 1rem 0;
    font-size: 0.85em;
  }
  .doc-texto th,
  .doc-texto td {
    border: 1px solid var(--color-border);
    padding: 0.4rem 0.6rem;
    text-align: left;
    vertical-align: top;
  }
  .doc-texto th {
    background: var(--color-bg);
    font-weight: 600;
  }
  .doc-texto hr {
    border: none;
    border-top: 1px solid var(--color-border);
    margin: 2rem 0;
  }
  /* Bloque para los datos pendientes de rellenar y para los avisos cortos. */
  .doc-texto .nota,
  .doc-texto blockquote {
    border-left: 3px solid var(--color-accent);
    background: var(--color-secondary);
    color: var(--color-secondary-ink);
    padding: 0.75rem 1rem;
    border-radius: 0 8px 8px 0;
    margin: 1.25rem 0;
  }
  .doc-texto .nota p,
  .doc-texto blockquote p {
    margin: 0.35rem 0;
  }

  /* Acordeones: una fila por sección, separadas por una línea. El título es
     el <h2> de siempre dentro del <summary>. */
  .doc-texto .acordeones {
    margin-top: 1rem;
    border-bottom: 1px solid var(--color-border);
  }
  .doc-texto .acordeon {
    border-top: 1px solid var(--color-border);
  }
  .doc-texto .acordeon > summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.95rem 0.25rem;
    cursor: pointer;
    list-style: none;
    border-radius: 6px;
  }
  .doc-texto .acordeon > summary::-webkit-details-marker {
    display: none;
  }
  .doc-texto .acordeon > summary::after {
    content: '';
    flex: none;
    width: 0.55rem;
    height: 0.55rem;
    margin-right: 0.35rem;
    border-right: 2px solid var(--color-ink-muted);
    border-bottom: 2px solid var(--color-ink-muted);
    transform: rotate(45deg) translate(-2px, -2px);
    transition: transform 150ms ease;
  }
  .doc-texto .acordeon[open] > summary::after {
    transform: rotate(-135deg) translate(-2px, -2px);
  }
  .doc-texto .acordeon > summary:hover h2 {
    color: var(--color-accent);
  }
  .doc-texto .acordeon > summary:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }
  .doc-texto .acordeon > summary h2 {
    margin: 0;
    font-size: 1.2rem;
  }
  .doc-texto .acordeon-cuerpo {
    padding: 0 0.25rem 1.25rem;
  }
  .doc-texto .acordeon-cuerpo > :first-child {
    margin-top: 0;
  }
  .doc-texto .acordeones-controles {
    margin: 1rem 0 0;
    text-align: right;
    font-size: 0.8125rem;
  }
  .doc-texto .acordeones-controles button {
    color: var(--color-accent);
    font-weight: 500;
    text-decoration: underline;
    text-underline-offset: 2px;
    cursor: pointer;
  }
  /* El ancla de una sección cerrada abre el acordeón (ver el script), así que
     el encabezado ya no queda tapado por la cabecera fija. */
  .doc-texto h2[id] {
    scroll-margin-top: 6rem;
  }
  @media (prefers-reduced-motion: reduce) {
    .doc-texto .acordeon > summary::after {
      transition: none;
    }
  }
</style>

<script>
  const secciones = () =>
    Array.from(
      document.querySelectorAll<HTMLDetailsElement>(
        '.doc-texto details.acordeon',
      ),
    );
  const boton = document.querySelector<HTMLButtonElement>(
    '[data-acordeones-alternar]',
  );

  function pintarBoton() {
    if (!boton) return;
    boton.textContent = secciones().every((d) => d.open)
      ? 'Contraer todo'
      : 'Expandir todo';
  }

  boton?.addEventListener('click', () => {
    const abrir = !secciones().every((d) => d.open);
    for (const d of secciones()) d.open = abrir;
    pintarBoton();
  });
  for (const d of secciones()) d.addEventListener('toggle', pintarBoton);
  pintarBoton();

  // Un enlace con ancla (#licencias) a una sección cerrada la abre antes de
  // llevar a ella; sin esto el navegador deja la vista sobre una fila cerrada.
  function abrirAncla() {
    const id = decodeURIComponent(window.location.hash.slice(1));
    if (!id) return;
    const destino = document.getElementById(id);
    const acordeon = destino?.closest('details');
    if (acordeon && !acordeon.open) {
      acordeon.open = true;
      destino?.scrollIntoView();
    }
  }
  abrirAncla();
  window.addEventListener('hashchange', abrirAncla);

  // Al imprimir, todo el documento debe salir desplegado.
  let abiertosAntes: boolean[] = [];
  window.addEventListener('beforeprint', () => {
    abiertosAntes = secciones().map((d) => d.open);
    for (const d of secciones()) d.open = true;
  });
  window.addEventListener('afterprint', () => {
    secciones().forEach((d, i) => {
      d.open = abiertosAntes[i] ?? d.open;
    });
  });
</script>
