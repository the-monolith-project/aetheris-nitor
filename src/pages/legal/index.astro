---
import Layout from '../../layouts/Layout.astro';
import Icono from '../../components/Icono.astro';

const SECCIONES = [
  {
    href: '/legal/privacidad',
    titulo: 'Política de Privacidad',
    descripcion:
      'Tratamiento de direcciones IP, ausencia de cookies, almacenamiento local y políticas de terceros como OpenStreetMap.',
    icono: 'shield-check',
  },
  {
    href: '/legal/terminos',
    titulo: 'Términos y Condiciones',
    descripcion:
      'Naturaleza académica, ausencia de garantías, límites de uso de la API pública y licenciamiento bajo GPL-3.0.',
    icono: 'file-text',
  },
  {
    href: '/legal/aviso-legal',
    titulo: 'Aviso Legal',
    descripcion:
      'Datos de identificación institucional del titular, entidad responsable, infraestructura de hospedaje y jurisdicción.',
    icono: 'building',
  },
];
---

<Layout
  title="EPI-Aetheris — Marco Legal y Privacidad"
  descripcion="Índice de documentación legal, privacidad de datos y condiciones de uso de EPI-Aetheris."
>
  <main
    id="contenido-principal"
    class="mx-auto max-w-4xl px-4 py-8 sm:px-8 sm:py-10 lg:px-12"
  >
    <header class="mb-8">
      <p class="font-mono text-xs font-semibold uppercase tracking-wider text-accent">
        Transparencia institucional
      </p>
      <h1
        class="mt-2 font-display text-2xl font-semibold tracking-tight text-ink sm:text-3xl"
      >
        Marco Legal y Confianza
      </h1>
      <p class="mt-3 max-w-2xl font-sans text-sm leading-relaxed text-ink-muted">
        Documentación que rige la privacidad técnica, las condiciones de uso de la API y los deslindes de responsabilidad de la plataforma.
      </p>
    </header>

    <div class="grid grid-cols-1 gap-4 sm:grid-cols-3">
      {
        SECCIONES.map((sec) => (
          <a
            href={sec.href}
            class="card-elevated group flex flex-col justify-between rounded-2xl border border-border bg-surface p-5 transition-all hover:border-accent"
          >
            <div>
              <div class="flex items-center gap-2 font-sans text-base font-semibold text-ink group-hover:text-accent">
                <Icono nombre={sec.icono} class="h-5 w-5 text-accent shrink-0" />
                <span>{sec.titulo}</span>
              </div>
              <p class="mt-2 font-sans text-xs leading-relaxed text-ink-muted">
                {sec.descripcion}
              </p>
            </div>
            <span class="mt-4 inline-flex items-center gap-1 font-sans text-xs font-medium text-accent">
              Leer documento &rarr;
            </span>
          </a>
        ))
      }
    </div>
  </main>
</Layout>
